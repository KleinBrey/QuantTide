{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.env.osx": {
    "PYTHONPATH": "${workspaceFolder}"
  },
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "cSpell.enabled": false,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Always generate Git commit messages in Simplified Chinese (zh-CN). Use Conventional Commits format: type: 中文描述. Keep technical identifiers unchanged. Keep the message concise, ideally under 50 Chinese characters. Output only the commit message."
    }
  ],
  "workbench.editorAssociations": {
    "*.parquet": "duckdb.dataFileViewer",
    "*.csv": "duckdb.dataFileViewer",
    "*.tsv": "duckdb.dataFileViewer",
    "*.xlsx": "duckdb.dataFileViewer"
  },
  "duckdb.databases": [
    {
      "alias": "hk_market",
      "type": "file",
      "path": "/Users/kleinbrey/Documents/QuantTide/data/hk_market.duckdb",
      "attached": false,
      "readOnly": false
    },
    {
      "alias": "us_market",
      "type": "file",
      "path": "/Users/kleinbrey/Documents/QuantTide/data/us_market.duckdb",
      "attached": false,
      "readOnly": false
    },
    {
      "alias": "cn_market",
      "type": "file",
      "path": "/Users/kleinbrey/Documents/QuantTide/data/cn_market.duckdb",
      "attached": false,
      "readOnly": false
    }
  ],
  "duckdb.defaultDatabase": "cn_market",
  "[sql]": {
    "editor.formatOnSave": false
  }
}
